{
  "dashboard": {
    "id": null,
    "title": "Kafka Integration Dashboard - Todo Chatbot",
    "tags": ["kafka", "todo-chatbot", "events"],
    "style": "dark",
    "timezone": "utc",
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Kafka Producer Metrics",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(kafka_produce_success_total[5m])",
            "legendFormat": "Successful Produces",
            "refId": "A"
          },
          {
            "expr": "rate(kafka_produce_error_total[5m])",
            "legendFormat": "Failed Produces",
            "refId": "B"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 2,
        "title": "Kafka Consumer Metrics",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(kafka_messages_received_total[5m])",
            "legendFormat": "Messages Received",
            "refId": "A"
          },
          {
            "expr": "kafka_consumer_lag_messages",
            "legendFormat": "Consumer Lag (messages)",
            "refId": "B"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 3,
        "title": "Event Processing Performance",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(kafka_message_process_duration_seconds_bucket[5m])) by (le, topic))",
            "legendFormat": "{{topic}} 95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(kafka_message_process_duration_seconds_bucket[5m])) by (le, topic))",
            "legendFormat": "{{topic}} 50th percentile",
            "refId": "B"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 4,
        "title": "System Health Status",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "up{job=\"todo-chatbot-api\"}",
            "legendFormat": "API Status",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 5,
        "title": "Delivery Success Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(rate(kafka_produce_success_total[5m])) / (sum(rate(kafka_produce_success_total[5m])) + sum(rate(kafka_produce_error_total[5m]))) * 100",
            "legendFormat": "Delivery Success Rate (%)",
            "refId": "A"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 6,
        "title": "Message Size Distribution",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(kafka_produced_message_size_bytes_bucket[5m])) by (le, topic))",
            "legendFormat": "{{topic}} 95th percentile (bytes)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(kafka_produced_message_size_bytes_bucket[5m])) by (le, topic))",
            "legendFormat": "{{topic}} 50th percentile (bytes)",
            "refId": "B"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 7,
        "title": "Circuit Breaker Status",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "kafka_circuit_breaker_state{state=\"open\"}",
            "legendFormat": "Open Circuits",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": ["lastNotNull"],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 8,
        "title": "Dead Letter Queue Events",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 24
        },
        "targets": [
          {
            "expr": "rate(dlq_events_total[5m])",
            "legendFormat": "DLQ Events Rate",
            "refId": "A"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      },
      {
        "id": 9,
        "title": "Consumer Group Lag by Topic",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "targets": [
          {
            "expr": "kafka_consumer_group_lag_total",
            "legendFormat": "{{group}}",
            "refId": "A"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "topic",
          "type": "query",
          "query": "label_values(kafka_messages_received_total, topic)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        },
        {
          "name": "consumer_group",
          "type": "query",
          "query": "label_values(kafka_consumer_lag_messages, group)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}