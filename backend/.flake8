[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .tox,
    build,
    dist,
    *.egg-info,
    node_modules
max-complexity = 10
docstring-convention = google
per-file-ignores =
    */__init__.py:F401
    */tests/*:S101,S106